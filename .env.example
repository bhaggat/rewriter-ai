# Chrome Web Store Auto Deploy Credentials (API v2)
# Publisher ID & Extension ID from developer console URL:
# https://chrome.google.com/webstore/devconsole/<CHROME_PUBLISHER_ID>/<CHROME_EXTENSION_ID>/edit
CHROME_API_VERSION=v2
CHROME_EXTENSION_ID=dfeikdphcfjnkdeolkcnblpdokkcddlm
CHROME_PUBLISHER_ID=adbed94e-07c7-40cf-a800-ededc8b898b1

# Google Cloud Service Account JSON key fields (client_email and private_key)
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
